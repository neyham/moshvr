<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- 2D panel: fill the system window. Horizon already rounds the chrome;
       a second clip on a light default windowBackground leaves gray/white bites. -->
  <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
    <item name="android:windowBackground">@color/panel_background</item>
    <item name="android:colorBackground">@color/panel_background</item>
    <item name="android:statusBarColor">@color/panel_background</item>
    <item name="android:navigationBarColor">@color/panel_background</item>
    <item name="android:windowLightStatusBar">false</item>
  </style>

  <!-- Transparent theme for spatial compose panels -->
  <style name="PanelAppThemeTransparent" parent="@android:style/Theme.NoTitleBar">
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:colorBackgroundCacheHint">@null</item>
    <item name="android:windowIsTranslucent">true</item>
  </style>
</resources>
